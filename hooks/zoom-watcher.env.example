# Configuration for the Zoom watcher (sourced as shell by zoom-watcher.sh).
# Install location: ~/.config/meetingrec/zoom-watcher.env
#
# launchd agents do NOT inherit your shell profile, so the recording env vars
# from ~/.zshrc must be repeated here.

export MEETINGREC_S3_BUCKET=<your-bucket-name>
export AWS_REGION=us-west-2

# Copy meeting notes into this Obsidian vault (with a meeting-notes tag and a
# model-generated title). Comment out to keep notes in ~/Recordings only.
#export MEETINGREC_OBSIDIAN_VAULT="$HOME/path/to/your/vault"

# Uncomment if your AWS credentials come from a named profile:
#export AWS_PROFILE=default

# Extra flags passed to meetingrec when a meeting starts.
#   "-s"  speaker-only (system audio, no mic)
#   "-n"  record only, skip transcription/summary
#export MEETINGREC_ZOOM_ARGS="-s"

# Path to the meetingrec binary (default: found on PATH).
#export MEETINGREC_BIN=/usr/local/bin/meetingrec

# How often to check for a Zoom meeting, in seconds (default 5), and how many
# consecutive meeting-free polls before the recording is stopped (default 3).
#export POLL_SECONDS=5
#export END_GRACE_POLLS=3
